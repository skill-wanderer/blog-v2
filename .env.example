# Sample environment file. Copy to `.env` and fill in real values.
# `.env` itself is git-ignored, so this file is the checked-in reference for
# which variables the site expects.
#
# The PUBLIC_* variables are inlined into the browser bundle, so they must not
# hold secrets. The RESEND_* ones at the bottom are server-only.

# Firebase configuration for Skill Wanderer Hub
PUBLIC_FIREBASE_API_KEY="your-api-key"
PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
PUBLIC_FIREBASE_APP_ID="your-app-id"
PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Pathfinder / Nova chatbot configuration
PUBLIC_PATHFINDER_API_URL="https://pathfinder.example.com"
PUBLIC_PATHFINDER_DOMAINS="skill-wanderer.com"
PUBLIC_PATHFINDER_SESSION_EXPIRY_MINUTES="30"
PUBLIC_PATHFINDER_SESSION_STORAGE="sessionStorage"

# ---------------------------------------------------------------------------
# Newsletter (Resend)
# ---------------------------------------------------------------------------
# Used by /api/subscribe. These are read at build time and inlined into the
# server (worker) bundle only, never the browser bundle. They are still secrets:
# never commit real values. For Cloudflare deploys, set them as build variables
# (Workers & Pages > blog-v2 > Settings > Build > Variables and secrets), not as
# runtime Worker secrets. See docs/newsletter-subscription.md.

# API key from https://resend.com/api-keys (needs access to Audiences and Emails)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Sender of the welcome email. The domain must be verified in Resend.
# Replies and unsubscribe requests go to this address unless RESEND_REPLY_TO is set.
RESEND_FROM_EMAIL="Skill Wanderer <hello@skill-wanderer.com>"

# Optional. Reply-To address for the welcome email, e.g. an inbox you actually
# read when the sender is a no-reply address. Replies and unsubscribe requests
# go here instead of RESEND_FROM_EMAIL. Does not need a verified domain.
RESEND_REPLY_TO="Skill Wanderer <hello@skill-wanderer.com>"
